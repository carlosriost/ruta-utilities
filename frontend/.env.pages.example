# Configuracion web de Firebase para la version de GitHub Pages (avance compartido).
# Copia este archivo como `.env.pages` para compilar en tu equipo con `npm run build:pages`.
# En GitHub van como variables del repositorio (Settings > Secrets and variables > Actions > Variables).
# Sin estos valores la pagina funciona igual, pero el avance queda en cada navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
