{
  "name": "ruta-utilities-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:offline": "tsc -b && vite build --config vite.offline.config.ts",
    "build:pages": "tsc -b && vite build --config vite.offline.config.ts --mode pages",
    "check:offline": "esbuild scripts/engine-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/engine-check.cjs --log-level=warning && node node_modules/.cache/engine-check.cjs",
    "check:render": "node scripts/render-check.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
