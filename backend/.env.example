# ---------------------------------------------------------------------------
# Ruta Utilities - configuracion del backend
# Copia este archivo como  backend/.env  y ajusta los valores.
# ---------------------------------------------------------------------------

# Cadena de conexion principal (PostgreSQL + driver psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ruta_utilities

# Base de datos usada por la suite de tests (NUNCA la misma que la principal)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ruta_utilities_test

APP_ENV=development
FRONTEND_URL=http://localhost:5174

# Proveedor de identidad: "demo" hoy, "entra" cuando se integre Microsoft Entra ID
AUTH_PROVIDER=demo

# Secreto usado para firmar el token de la sesion demo
DEMO_TOKEN_SECRET=cambia-esto-en-tu-entorno

# Usuario demo que crea el seed
DEMO_USER_NAME=Carlos Rios
DEMO_USER_AREA=Utilities
DEMO_USER_PLANT=Cerveceria Itagui
DEMO_USER_ROLE=Operario

# Umbral por defecto para desbloquear la siguiente fase (%)
DEFAULT_UNLOCK_THRESHOLD=90
